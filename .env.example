# WorkNest Environment Configuration
# Copy this file to .env.local for local development.

# ==============================================================================
# AI WORKSPACE CONFIGURATION (Google Gemini API)
# ==============================================================================
# Obtain a free Google Gemini API key at: https://aistudio.google.com
# Keep this key strictly confidential; it is processed solely on the backend.
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Default Gemini model (default: gemini-3.5-flash)
AI_MODEL=gemini-3.5-flash

# ==============================================================================
# SUPABASE CONFIGURATION (Authentication & Cloud Sync)
# ==============================================================================
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Optional: Application URL for auth redirects
NEXT_PUBLIC_SITE_URL=http://localhost:3000
